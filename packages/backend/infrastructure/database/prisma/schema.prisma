  description       String?   @db.Text
  publishStatus     String    @default("draft") @map("publish_status") @db.VarChar(50)
  examType          String    @default("FULL_MOCK") @map("exam_type") @db.VarChar(50)
  certificationType String?   @map("certification_type") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           BigInt    @default(1)
  duration          Int       @default(0)
  totalQuestions    Int       @default(0) @map("total_questions")
