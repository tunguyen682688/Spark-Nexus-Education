  repetitions Int      @default(0)
  dueDate     DateTime @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, quizId], name: "idx_user_srs_quiz")
  @@map("user_srs_progress")
}

model GrammarExamSet {
  id           String                @id @default(uuid())
  title        String                @db.VarChar(200)
  description  String                @db.Text
  level        String                @db.VarChar(10) // A1, A2, B1, B2, C1, C2 hoặc "ALL" cho TOEIC/IELTS
  examType     String                @default("CEFR") @map("exam_type") @db.VarChar(50) // CEFR, TOEIC, IELTS, VSTEP
  examMetadata Json                  @default("{}") @map("exam_metadata") // Lưu trữ metadata chuyên sâu (ví dụ: { targetBand: "6.5", toeicPart: 5 })
  creatorId    String                @map("creator_id")
  creatorName  String                @default("Cộng tác viên") @map("creator_name") @db.VarChar(100)
  questions    Json                  @default("[]") // [{ id, text, type, options, answer, explanation, category, words, sentence, incorrectWord, correctWord }]
  timeLimit    Int                   @default(600) @map("time_limit") // Thời gian làm bài tính bằng giây (ví dụ: 10 phút)
  upvotes      Int                   @default(0)
  status       String                @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  deleted      Boolean               @default(false)
  progress     UserExamSetProgress[]

  @@index([level])
  @@index([examType])
  @@index([status])
  @@index([deleted])
  @@map("grammar_exam_sets")
}

model UserExamSetProgress {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  examSetId String         @map("exam_set_id")
  bestScore Float          @map("best_score") @db.DoublePrecision // Điểm phần trăm cao nhất (ví dụ: 85.5)
  isPassed  Boolean        @default(false) @map("is_passed") // true nếu bestScore >= 80.0
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  examSet   GrammarExamSet @relation(fields: [examSetId], references: [id], onDelete: Cascade)

  @@unique([userId, examSetId], name: "idx_user_exam_set")
  @@index([userId])
  @@index([examSetId])
  @@map("user_exam_set_progress")
}

model CommunityGrammarCertificate {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  level        String   @db.VarChar(10) // Cấp độ (A1-C2) hoặc hệ quy chuẩn (TOEIC, IELTS, VSTEP)
  examType     String   @default("CEFR") @map("exam_type") @db.VarChar(50) // CEFR, TOEIC, IELTS, VSTEP
  serialNumber String   @unique @map("serial_number") @db.VarChar(100) // CERT-SNE-XXXX
  issuedAt     DateTime @default(now()) @map("issued_at")
  metadata     Json     @default("{}") // Tên học viên, điểm số cao nhất đạt được

  @@index([userId])
  @@index([examType])
  @@map("community_grammar_certificates")
}

model UserGrammarTrap {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  questionId    String   @map("question_id")
  questionText  String   @map("question_text") @db.Text
  questionType  String   @map("question_type") // MULTIPLE_CHOICE, SENTENCE_BUILDER, ERROR_SPOTLIGHT
  questionData  Json     @map("question_data") // Lưu trữ options, words, sentence, etc.
  category      String   @db.VarChar(50) // syntax, tenses, morphology, modality
  userAnswer    String   @map("user_answer") @db.Text
  correctAnswer String   @map("correct_answer") @db.Text
  explanation   String   @db.Text
  aiAnalysis    String?  @map("ai_analysis") @db.Text // Cached AI Analysis of the grammar trap
  status        String   @default("TRAPPED") @db.VarChar(50) // TRAPPED, BROKEN
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, questionId], name: "idx_user_question_trap")
  @@index([userId])
  @@index([status])
  @@map("user_grammar_traps")
}

model TranslationCache {
  id             String   @id @default(uuid())
  hash           String   @unique @db.VarChar(64)
  originalText   String   @map("original_text") @db.Text
  translatedText String   @map("translated_text") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("translation_caches")
}

model ArticleVocabularyHighlight {
  id                 String   @id @default(uuid())
  articleId          String   @map("article_id")
  entryId            String   @map("entry_id")
  blockId            String   @map("block_id")
  wordIndex          Int      @map("word_index")
  occurrenceText     String   @map("occurrence_text") @db.VarChar(100)
  customDefinition   String?  @db.Text
  customExample      String?  @db.Text
  customExampleTrans String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entry   Entry   @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([articleId, blockId, wordIndex], map: "idx_article_block_word")
  @@index([articleId])
  @@index([entryId])
  @@map("article_vocabulary_highlights")
}

// ============================================
// LISTENING DOMAIN (Phân hệ Luyện nghe)
// ============================================

model ListeningMaterial {
  id              String    @id @default(uuid())
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  category        String    @db.VarChar(50) // podcast, audio, exam, video
  difficulty      String    @db.VarChar(10) // A1, A2, B1, B2, C1, C2
  mediaUrl        String    @map("media_url") @db.VarChar(500) // Đường dẫn file audio hoặc video stream
  youtubeId       String?   @map("youtube_id") @db.VarChar(100) // ID video YouTube (nếu có)
  thumbnailUrl    String?   @map("thumbnail_url") @db.VarChar(500) // Ảnh đại diện
  duration        Int // Thời lượng tính bằng giây
  author          String?   @db.VarChar(100) // Tác giả, diễn giả hoặc host
  viewCount       Int       @default(0) @map("view_count")
  isCommunity     Boolean   @default(false) @map("is_community") // Đánh dấu tài liệu do cộng đồng đóng góp
  upvotes         Int       @default(0)
  downvotes       Int       @default(0)
  isPublished     Boolean   @default(false) @map("is_published")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deleted         Boolean   @default(false)
  creatorId       String?   @map("creator_id") // ID người tạo (GV/CTV/Thành viên cộng đồng)
  vocabularySetId String?   @map("vocabulary_set_id") // Bộ từ vựng đi kèm bài học (nếu có)
  tags            String[]  @default([])

  // Quan hệ
  vocabularySet VocabularySet?                 @relation(fields: [vocabularySetId], references: [id], onDelete: SetNull)
  subtitles     ListeningSubtitle[]
  questions     ListeningQuestion[]
  progress      ListeningProgress[]
  sessions      ListeningSession[]
  bookmarks     UserListeningBookmark[]
  comments      ListeningComment[]
  highlights    ListeningVocabularyHighlight[]
  votes         ListeningVote[]

  @@index([category])
  @@index([difficulty])
  @@index([isPublished])
  @@index([isCommunity])
  @@index([deleted])
  @@index([createdAt])
  @@map("listening_materials")
}

model ListeningVote {
  userId     String   @map("user_id")
  materialId String   @map("material_id")
  vote       Int // 1: upvote, -1: downvote
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
  @@index([materialId])
  @@map("listening_votes")
}

model ListeningSubtitle {
  id          String  @id @default(uuid())
  materialId  String  @map("material_id")
  startTime   Float   @map("start_time") // Thời gian bắt đầu (giây, ví dụ: 12.34)
  endTime     Float   @map("end_time") // Thời gian kết thúc (giây)
  text        String  @db.Text // Tiếng Anh bản xứ
  translation String? @db.Text // Bản dịch tiếng Việt song ngữ
  order       Int // Thứ tự sắp xếp câu trong bài nghe

  // Quan hệ
  material   ListeningMaterial              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  highlights ListeningVocabularyHighlight[]

  @@index([materialId])
  @@index([materialId, order])
  @@map("listening_subtitles")
}

model ListeningQuestion {
  id             String  @id @default(uuid())
  materialId     String  @map("material_id")
  questionText   String  @map("question_text") @db.Text
  options        Json // Mảng các lựa chọn: ["A", "B", "C", "D"] hoặc ["Option A", "Option B", ...]
  correctAnswer  String  @map("correct_answer") @db.VarChar(255) // Đáp án đúng
  explanation    String? @db.Text // Giải thích chi tiết
  audioTimestamp Float?  @map("audio_timestamp") // Tua lại đúng đoạn audio phát ra đáp án
  order          Int // Thứ tự câu hỏi trong đề thi/bài tập

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([materialId, order])
  @@map("listening_questions")
}

model ListeningProgress {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  materialId   String    @map("material_id")
  progress     Int       @default(0) // Tiến độ từ 0 - 100%
  lastPosition Float     @default(0) @map("last_position") // Vị trí giây nghe cuối cùng để resume
  timeSpent    Int       @default(0) @map("time_spent") // Tổng thời gian đã nghe (giây)
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId], name: "idx_user_listening_material")
  @@index([userId])
  @@index([materialId])
  @@map("listening_progress")
}

model ListeningSession {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  materialId String   @map("material_id")
  duration   Int // Số giây đã nghe trong phiên này
  createdAt  DateTime @default(now()) @map("created_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("listening_sessions")
}

model UserListeningBookmark {
  userId     String   @map("user_id")
  materialId String   @map("material_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
  @@index([userId])
  @@map("user_listening_bookmarks")
}

model ListeningComment {
  id         String   @id @default(uuid())
  materialId String   @map("material_id")
  userId     String   @map("user_id")
  content    String   @db.Text
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([userId])
  @@index([createdAt])
  @@map("listening_comments")
}

model ListeningVocabularyHighlight {
  id                 String   @id @default(uuid())
  materialId         String   @map("material_id")
  subtitleId         String   @map("subtitle_id")
  entryId            String   @map("entry_id")
  wordIndex          Int      @map("word_index") // Vị trí của từ trong subtitle text (0-indexed)
  occurrenceText     String   @map("occurrence_text") @db.VarChar(100)
  customDefinition   String?  @db.Text
  customExample      String?  @db.Text
  customExampleTrans String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  subtitle ListeningSubtitle @relation(fields: [subtitleId], references: [id], onDelete: Cascade)
  entry    Entry             @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([subtitleId, wordIndex], map: "idx_listening_sub_word")
  @@index([materialId])
  @@index([entryId])
  @@map("listening_vocabulary_highlights")
}

model UserListeningStats {
  userId         String   @id @map("user_id")
  totalMaterials Int      @default(0) @map("total_materials")
  totalTime      Int      @default(0) @map("total_time") // Tổng thời lượng nghe tính bằng giây
  masteryLevel   String   @default("A1") @map("mastery_level")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_listening_stats")
}

// ============================================
// EXAM PLATFORM - COLLECTION SCHEMA
// ============================================

model Collection {
  id            String    @id @default(uuid())
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  ownerId       String    @map("owner_id")
  publishStatus String    @default("draft") @map("publish_status") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       BigInt    @default(1)

  // Relations
  items         CollectionItem[]
  collaborators CollectionCollaborator[]
  favorites     CollectionFavorite[]
  bookmarks     CollectionBookmark[]
  chapters      Chapter[]
  exams         Exam[]
  reviews       CollectionReview[]
  discussions   CollectionDiscussion[]

  @@index([ownerId])
  @@index([publishStatus])
  @@map("collections")
}

model Chapter {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  exams      Exam[]

  @@index([collectionId])
  @@map("chapters")
}

model CollectionItem {
