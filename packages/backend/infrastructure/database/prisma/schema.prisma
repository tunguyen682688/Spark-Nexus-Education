  status        String   @default("TRAPPED") @db.VarChar(50) // TRAPPED, BROKEN
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, questionId], name: "idx_user_question_trap")
  @@index([userId])
  @@index([status])
  @@map("user_grammar_traps")
}

model TranslationCache {
  id             String   @id @default(uuid())
  hash           String   @unique @db.VarChar(64)
  originalText   String   @map("original_text") @db.Text
  translatedText String   @map("translated_text") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("translation_caches")
}

model ArticleVocabularyHighlight {
  id                 String   @id @default(uuid())
  articleId          String   @map("article_id")
  entryId            String   @map("entry_id")
  blockId            String   @map("block_id")
  wordIndex          Int      @map("word_index")
  occurrenceText     String   @map("occurrence_text") @db.VarChar(100)
  customDefinition   String?  @db.Text
  customExample      String?  @db.Text
  customExampleTrans String?  @db.Text
