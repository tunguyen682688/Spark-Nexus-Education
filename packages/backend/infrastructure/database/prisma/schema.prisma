  action     String   @db.VarChar(255)
  targetId   String?  @map("target_id")
  targetType String?  @map("target_type") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model IntegrationConfiguration {
  id          String   @id @default(uuid())
  serviceName String   @map("service_name") @db.VarChar(100)
  isEnabled   Boolean  @default(false) @map("is_enabled")
  credentials Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_configurations")
}

model BackupPolicy {
  id            String   @id @default(uuid())
  policyName    String   @map("policy_name") @db.VarChar(150)
  frequency     String   @db.VarChar(50)
  retentionDays Int      @map("retention_days")
  isEnabled     Boolean  @default(true) @map("is_enabled")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("backup_policies")
}

// ============================================
// CERTIFICATION PLATFORM - USER DATA SCHEMA
// ============================================

model UserDownload {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  itemType    String   @map("item_type") @db.VarChar(50) // collection, exam, question
  itemId      String   @map("item_id")
  fileName    String   @map("file_name") @db.VarChar(255)
  fileSize    Int      @default(0) @map("file_size")
  downloadUrl String?  @map("download_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_downloads")
}

model CollectionPurchase {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  collectionId  String   @map("collection_id")
  purchasedAt   DateTime @default(now()) @map("purchased_at")
  amount        Float    @default(0.0)
  currency      String   @default("USD") @db.VarChar(10)
  paymentStatus String   @default("completed") @db.VarChar(50) @map("payment_status")

  @@unique([userId, collectionId])
  @@map("collection_purchases")
}

model CollectionReport {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  reason       String?  @db.Text
  status       String   @default("pending") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("collection_reports")
}

model CollectionReview {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  rating       Int      @db.SmallInt
  text         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([userId])
  @@map("collection_reviews")
}

model CollectionDiscussion {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  title        String   @db.VarChar(255)
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  replies    DiscussionReply[]

  @@index([collectionId])
  @@index([userId])
  @@map("collection_discussions")
}

model DiscussionReply {
  id            String   @id @default(uuid())
  discussionId  String   @map("discussion_id")
  userId        String   @map("user_id")
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  discussion CollectionDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@map("discussion_replies")
}
