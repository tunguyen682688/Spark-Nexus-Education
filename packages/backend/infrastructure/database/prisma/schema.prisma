  updatedAt          DateTime @updatedAt @map("updated_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entry   Entry   @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([articleId, blockId, wordIndex], map: "idx_article_block_word")
  @@index([articleId])
  @@index([entryId])
  @@map("article_vocabulary_highlights")
}

// ============================================
// LISTENING DOMAIN (Phân hệ Luyện nghe)
// ============================================

model ListeningMaterial {
  id              String    @id @default(uuid())
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  category        String    @db.VarChar(50) // podcast, audio, exam, video
  difficulty      String    @db.VarChar(10) // A1, A2, B1, B2, C1, C2
  mediaUrl        String    @map("media_url") @db.VarChar(500) // Đường dẫn file audio hoặc video stream
  youtubeId       String?   @map("youtube_id") @db.VarChar(100) // ID video YouTube (nếu có)
  thumbnailUrl    String?   @map("thumbnail_url") @db.VarChar(500) // Ảnh đại diện
  duration        Int // Thời lượng tính bằng giây
  author          String?   @db.VarChar(100) // Tác giả, diễn giả hoặc host
  viewCount       Int       @default(0) @map("view_count")
  isCommunity     Boolean   @default(false) @map("is_community") // Đánh dấu tài liệu do cộng đồng đóng góp
  upvotes         Int       @default(0)
  downvotes       Int       @default(0)
  isPublished     Boolean   @default(false) @map("is_published")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deleted         Boolean   @default(false)
  creatorId       String?   @map("creator_id") // ID người tạo (GV/CTV/Thành viên cộng đồng)
  vocabularySetId String?   @map("vocabulary_set_id") // Bộ từ vựng đi kèm bài học (nếu có)
  tags            String[]  @default([])

  // Quan hệ
  vocabularySet VocabularySet?                 @relation(fields: [vocabularySetId], references: [id], onDelete: SetNull)
  subtitles     ListeningSubtitle[]
  questions     ListeningQuestion[]
  progress      ListeningProgress[]
  sessions      ListeningSession[]
  bookmarks     UserListeningBookmark[]
  comments      ListeningComment[]
  highlights    ListeningVocabularyHighlight[]
  votes         ListeningVote[]

  @@index([category])
  @@index([difficulty])
  @@index([isPublished])
  @@index([isCommunity])
  @@index([deleted])
  @@index([createdAt])
  @@map("listening_materials")
}

model ListeningVote {
  userId     String   @map("user_id")
  materialId String   @map("material_id")
  vote       Int // 1: upvote, -1: downvote
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
  @@index([materialId])
  @@map("listening_votes")
}

model ListeningSubtitle {
  id          String  @id @default(uuid())
  materialId  String  @map("material_id")
  startTime   Float   @map("start_time") // Thời gian bắt đầu (giây, ví dụ: 12.34)
  endTime     Float   @map("end_time") // Thời gian kết thúc (giây)
  text        String  @db.Text // Tiếng Anh bản xứ
  translation String? @db.Text // Bản dịch tiếng Việt song ngữ
  order       Int // Thứ tự sắp xếp câu trong bài nghe

  // Quan hệ
  material   ListeningMaterial              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  highlights ListeningVocabularyHighlight[]

  @@index([materialId])
  @@index([materialId, order])
  @@map("listening_subtitles")
}

model ListeningQuestion {
  id             String  @id @default(uuid())
  materialId     String  @map("material_id")
  questionText   String  @map("question_text") @db.Text
  options        Json // Mảng các lựa chọn: ["A", "B", "C", "D"] hoặc ["Option A", "Option B", ...]
  correctAnswer  String  @map("correct_answer") @db.VarChar(255) // Đáp án đúng
  explanation    String? @db.Text // Giải thích chi tiết
  audioTimestamp Float?  @map("audio_timestamp") // Tua lại đúng đoạn audio phát ra đáp án
  order          Int // Thứ tự câu hỏi trong đề thi/bài tập

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([materialId, order])
  @@map("listening_questions")
}

model ListeningProgress {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  materialId   String    @map("material_id")
  progress     Int       @default(0) // Tiến độ từ 0 - 100%
  lastPosition Float     @default(0) @map("last_position") // Vị trí giây nghe cuối cùng để resume
  timeSpent    Int       @default(0) @map("time_spent") // Tổng thời gian đã nghe (giây)
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId], name: "idx_user_listening_material")
  @@index([userId])
  @@index([materialId])
  @@map("listening_progress")
}

model ListeningSession {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  materialId String   @map("material_id")
  duration   Int // Số giây đã nghe trong phiên này
  createdAt  DateTime @default(now()) @map("created_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("listening_sessions")
}

model UserListeningBookmark {
  userId     String   @map("user_id")
  materialId String   @map("material_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
  @@index([userId])
  @@map("user_listening_bookmarks")
}

model ListeningComment {
  id         String   @id @default(uuid())
  materialId String   @map("material_id")
  userId     String   @map("user_id")
  content    String   @db.Text
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([userId])
  @@index([createdAt])
  @@map("listening_comments")
}

model ListeningVocabularyHighlight {
  id                 String   @id @default(uuid())
  materialId         String   @map("material_id")
  subtitleId         String   @map("subtitle_id")
  entryId            String   @map("entry_id")
  wordIndex          Int      @map("word_index") // Vị trí của từ trong subtitle text (0-indexed)
  occurrenceText     String   @map("occurrence_text") @db.VarChar(100)
  customDefinition   String?  @db.Text
  customExample      String?  @db.Text
  customExampleTrans String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Quan hệ
  material ListeningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  subtitle ListeningSubtitle @relation(fields: [subtitleId], references: [id], onDelete: Cascade)
  entry    Entry             @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([subtitleId, wordIndex], map: "idx_listening_sub_word")
  @@index([materialId])
  @@index([entryId])
  @@map("listening_vocabulary_highlights")
}

model UserListeningStats {
  userId         String   @id @map("user_id")
  totalMaterials Int      @default(0) @map("total_materials")
  totalTime      Int      @default(0) @map("total_time") // Tổng thời lượng nghe tính bằng giây
  masteryLevel   String   @default("A1") @map("mastery_level")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_listening_stats")
}

// ============================================
// EXAM PLATFORM - COLLECTION SCHEMA
// ============================================

model Collection {
  id            String    @id @default(uuid())
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  subtitle      String?   @db.Text
  level         String?   @db.VarChar(50)
  tags          String[]  @default([])
  visibility    String    @default("Public") @db.VarChar(50)
  allowDownloads Boolean  @default(true) @map("allow_downloads")
  coverImage    String?   @map("cover_image")
  ownerId       String    @map("owner_id")
  publishStatus String    @default("draft") @map("publish_status") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       BigInt    @default(1)

  // Relations
  items         CollectionItem[]
  favorites     CollectionFavorite[]
  bookmarks     CollectionBookmark[]
  chapters      Chapter[]
  exams         Exam[]
  reviews       CollectionReview[]
  discussions   CollectionDiscussion[]

  @@index([ownerId])
  @@index([publishStatus])
  @@map("collections")
}

model Chapter {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  exams       Exam[]

  @@index([collectionId])
  @@index([collectionId, order])
  @@map("chapters")
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  examId       String?  @map("exam_id")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  exam       Exam?      @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([examId])
  @@map("collection_items")
}



model CollectionFavorite {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@map("collection_favorites")
}

model CollectionBookmark {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@map("collection_bookmarks")
}

// ============================================
// EXAM PLATFORM - EXAM SCHEMA
// ============================================

model Exam {
  id                    String    @id @default(uuid())
  collectionId          String    @map("collection_id")
  chapterId             String?   @map("chapter_id")
  title                 String    @db.VarChar(255)
  description           String?   @db.Text
  publishStatus         String    @default("draft") @map("publish_status") @db.VarChar(50)
  examType              String    @default("FULL_MOCK") @map("exam_type") @db.VarChar(50)
  certificationType     String?   @map("certification_type") @db.VarChar(50)
  level                 String?   @db.VarChar(50) @default("intermediate")
  order                 Int       @default(0)
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String?   @map("created_by")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  updatedBy             String?   @map("updated_by")
  deletedAt             DateTime? @map("deleted_at")
  version               BigInt    @default(1)
  duration              Int       @default(0)
  totalQuestions        Int       @default(0) @map("total_questions")
  maxScore              Float     @default(100.0) @map("max_score")
  passScore             Float     @default(50.0) @map("pass_score")
  initializationStatus  String    @default("none") @map("initialization_status") @db.VarChar(50)

  // Relations
  collection    Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  chapter       Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sections      ExamSection[]
  examQuestions ExamQuestion[]
  sessions      ExamSession[]
  items         CollectionItem[]

  @@index([collectionId])
  @@index([chapterId])
  @@index([publishStatus])
  @@index([certificationType])
  @@map("exams")
}

model ExamSection {
  id              String   @id @default(uuid())
  examId          String   @map("exam_id")
  title           String   @db.VarChar(255)
  subtitle        String?  @db.VarChar(255)
  sectionType     String   @default("general") @map("section_type") @db.VarChar(50)
  instruction     String?  @db.Text
  order           Int
  durationMinutes Int      @default(0) @map("duration_minutes")
  questionCount   Int      @default(0) @map("question_count")
  isBreak         Boolean  @default(false) @map("is_break")

  // Section-level media — reference MediaFile by ID (not URL)
  audioMediaId    String?  @map("audio_media_id")
  scriptText      String?  @map("script_text") @db.Text
  passageText     String?  @map("passage_text") @db.Text
  passageTitle    String?  @map("passage_title") @db.VarChar(255)
  passageType     String?  @map("passage_type") @db.VarChar(50)

  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  // Relations
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  audioMedia MediaFile? @relation("ExamSectionAudio", fields: [audioMediaId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([examId, order])
  @@index([audioMediaId])
  @@map("exam_sections")
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String   @map("exam_id")
  questionId String   @map("question_id")
  sectionId  String?  @map("section_id")
  order      Int
  points     Float    @default(1.0)
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  // Content hash for server-side skip-unchanged optimization
  contentHash String? @map("content_hash") @db.VarChar(64)

  // Per-exam media overrides — reference MediaFile by ID (not URL)
  audioMediaId    String?  @map("audio_media_id")
  imageMediaId    String?  @map("image_media_id")

  // Per-exam positioning
  partNumber     Int?    @map("part_number")
  gapNumber      Int?    @map("gap_number")

  // Per-exam writing/speaking config
  writingTaskType String? @map("writing_task_type") @db.VarChar(100)
  speakingPrompt  String? @map("speaking_prompt") @db.Text

  // SAT specific
  isGridIn        Boolean @default(false) @map("is_grid_in")

  // Format metadata (flexible JSON for per-exam extra data)
  formatMetadata  Json?   @map("format_metadata")

  // Passage grouping for multi-question types (TOEIC Part 6/7)
  passageGroupId     String? @map("passage_group_id") @db.VarChar(100)
  blankNumber        Int?    @map("blank_number")
  subQuestionNumber  Int?    @map("sub_question_number")
  passageTitle       String? @map("passage_title") @db.VarChar(255)
  passageType        String? @map("passage_type") @db.VarChar(50)

  // Relations
  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  section  ExamSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  audioMedia MediaFile? @relation("ExamQuestionAudio", fields: [audioMediaId], references: [id], onDelete: SetNull)
  imageMedia MediaFile? @relation("ExamQuestionImage", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([questionId])
  @@index([sectionId])
  @@index([audioMediaId])
  @@index([imageMediaId])
  @@index([examId, sectionId])
  @@index([examId, order])
  @@unique([examId, questionId])
  @@map("exam_questions")
}

// ============================================
// EXAM PLATFORM - QUESTION BANK SCHEMA
// ============================================

model Question {
  id         String    @id @default(uuid())
  title      String?   @db.VarChar(255)
  content    String    @db.Text
  type       String    @db.VarChar(50) // multiple_choice, essay, fill_in_blank, etc.
  difficulty String    @db.VarChar(50) // easy, medium, hard
  category   String?   @db.VarChar(100) // reading, listening, grammar, vocabulary, writing, speaking
  status     String    @default("draft") @db.VarChar(50)
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  version    BigInt    @default(1)

  // Relations
  choices       QuestionChoice[]
  versions      QuestionVersion[]
  examQuestions ExamQuestion[]
  metadata      QuestionMetadata?

  @@index([status])
  @@index([type])
  @@index([difficulty])
  @@index([category])
  @@index([createdBy])
  @@map("questions")
}

model QuestionChoice {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  content    String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([questionId, order])
  @@map("question_choices")
}

model QuestionVersion {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  version    Int
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([questionId, version])
  @@map("question_versions")
}

model QuestionMetadata {
  id               String   @id @default(uuid())
  questionId       String   @unique @map("question_id")
  explanation      String?  @db.Text
  points           Int      @default(1)
  estimatedTime    String?  @map("estimated_time") @db.VarChar(10)
  shuffleOptions   Boolean  @default(false) @map("shuffle_options")
  referenceType    String?  @map("reference_type") @db.VarChar(50)
  passageSource    String?  @map("passage_source") @db.VarChar(255)
  highlight        String?  @db.VarChar(500)
  cognitiveLevel   String?  @map("cognitive_level") @db.VarChar(50)
  tags             String[] @default([])
  skills           String[] @default([])
  qualityScore     Int?     @map("quality_score")
  qualityRating    String?  @map("quality_rating") @db.VarChar(50)

  // Question content fields (moved from ExamQuestion — these are question-level, not per-exam)
  passageId        String?  @map("passage_id") @db.VarChar(100)
  passageText      String?  @map("passage_text") @db.Text
  modelAnswer      String?  @map("model_answer") @db.Text
  rubric           Json?    @map("rubric")
  matchingPairs    Json?    @map("matching_pairs")
  wordRoot         String?  @map("word_root") @db.VarChar(255)
  keyWord          String?  @map("key_word") @db.VarChar(255)

  // Merged from deleted tables (QuestionMedia, QuestionHint)
  media            Json?    @map("media") // [{ url: string, type: 'image'|'audio'|'video' }]
  hints            Json?    @map("hints") // [{ content: string, order: number }]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_metadata")
}

// ============================================
// EXAM PLATFORM - SESSION SCHEMA
// ============================================

model ExamSession {
  id        String    @id @default(uuid())
  examId    String    @map("exam_id")
  userId    String    @map("user_id")
  status    String    @default("started") @db.VarChar(50) // started, in_progress, completed, abandoned
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  version   BigInt    @default(1)

  // Relations
  exam       Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers    SessionAnswer[]
  violations SessionViolation[]
  result     ExamResult?

  @@index([userId])
  @@index([examId])
  @@index([examId, userId])
  @@index([status])
  @@map("exam_sessions")
}

model SessionAnswer {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  questionId String   @map("question_id")
  answerText String?  @map("answer_text") @db.Text
  choiceIds  String[] @map("choice_ids")
  isCorrect  Boolean? @map("is_correct")
  points     Float?
  savedAt    DateTime @default(now()) @map("saved_at")
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  // Relations
  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, questionId])
  @@index([questionId])
  @@map("session_answers")
}

model SessionViolation {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  violationType String   @map("violation_type") @db.VarChar(100)
  description   String?  @db.Text
  occurredAt    DateTime @default(now()) @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_violations")
}

// ============================================
// EXAM PLATFORM - RESULT SCHEMA
// ============================================

model ExamResult {
  id               String   @id @default(uuid())
  sessionId        String   @unique @map("session_id")
  userId           String   @map("user_id")
  examId           String   @map("exam_id")
  totalScore       Float    @map("total_score")
  maxScore         Float    @default(100.0) @map("max_score")
  accuracyRate     Float    @default(0.0) @map("accuracy_rate")
  timeSpentMinutes Int      @default(0) @map("time_spent_minutes")
  passed           Boolean  @default(false)
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  // Relations
  session    ExamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skills     SkillResult[]
  questions  QuestionResult[]
  evaluation AiEvaluation?

  @@index([userId])
  @@index([examId])
  @@index([examId, userId])
  @@index([sessionId])
  @@index([passed])
  @@map("exam_results")
}

model SkillResult {
  id           String   @id @default(uuid())
  resultId     String   @map("result_id")
  skillName    String   @map("skill_name") @db.VarChar(100)
  score        Float
  maxScore     Float    @map("max_score")
  accuracyRate Float    @map("accuracy_rate")
  feedback     String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  result ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("skill_results")
}

model QuestionResult {
  id            String   @id @default(uuid())
  resultId      String   @map("result_id")
  questionId    String   @map("question_id")
  questionText  String?  @map("question_text") @db.Text
  isCorrect     Boolean  @map("is_correct")
  scoreAwarded  Float    @map("score_awarded")
  userAnswer    String?  @map("user_answer") @db.Text
  correctAnswer String?  @map("correct_answer") @db.Text
  explanation   String?  @db.Text
  timeSpent     Int      @map("time_spent")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  result ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([questionId])
  @@index([resultId, questionId])
  @@map("question_results")
}

model AiEvaluation {
  id             String   @id @default(uuid())
  resultId       String   @unique @map("result_id")
  evaluationText String   @map("evaluation_text") @db.Text
  feedbackJson   Json     @map("feedback_json")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  result ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("ai_evaluations")
}



// ============================================
// EXAM PLATFORM - CREATOR PROFILE SCHEMA
// ============================================

model CreatorProfile {
  id          String   @id @default(uuid()) @map("creator_id")
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name") @db.VarChar(255)
  bio         String?  @db.Text
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("creator_profiles")
}









// ============================================
// CERTIFICATION PLATFORM - USER DATA SCHEMA
// ============================================

model UserDownload {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  itemType    String   @map("item_type") @db.VarChar(50) // collection, exam, question
  itemId      String   @map("item_id")
  fileName    String   @map("file_name") @db.VarChar(255)
  fileSize    Int      @default(0) @map("file_size")
  downloadUrl String?  @map("download_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([itemType, itemId])
  @@map("user_downloads")
}

model CollectionPurchase {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  collectionId  String   @map("collection_id")
  purchasedAt   DateTime @default(now()) @map("purchased_at")
  amount        Float    @default(0.0)
  currency      String   @default("USD") @db.VarChar(10)
  paymentStatus String   @default("completed") @db.VarChar(50) @map("payment_status")

  @@unique([userId, collectionId])
  @@index([userId])
  @@index([collectionId])
  @@map("collection_purchases")
}

model CollectionReport {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  reason       String?  @db.Text
  status       String   @default("pending") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([collectionId])
  @@index([userId])
  @@index([status])
  @@map("collection_reports")
}

model CollectionReview {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  rating       Int      @db.SmallInt
  text         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([collectionId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("collection_reviews")
}

model CollectionDiscussion {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  userId       String   @map("user_id")
  title        String   @db.VarChar(255)
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  replies    DiscussionReply[]

  @@index([collectionId])
  @@index([collectionId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("collection_discussions")
}

model DiscussionReply {
  id            String   @id @default(uuid())
  discussionId  String   @map("discussion_id")
  userId        String   @map("user_id")
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  discussion CollectionDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([discussionId, createdAt])
  @@index([userId])
  @@map("discussion_replies")
}

// ─── Object Storage ──────────────────────────────────────────────────────────
model MediaFile {
  id            String   @id @default(uuid())
  storageKey    String   @unique @map("storage_key") // "media/{uuid}.{ext}" — server-generated
  bucket        String   // "r2-primary" | "b2-backup"
  provider      String   // "r2" | "b2" | "local"
  mimeType      String   @map("mime_type") @db.VarChar(127)
  size          Int      // bytes
  originalName  String   @map("original_name") @db.VarChar(500)
  width         Int?
  height        Int?
  visibility    String   @default("public") // "public" | "private"
  status        String   @default("pending") // "pending" | "active" | "deleted" | "processing"
  checksum      String?  @db.VarChar(64) // SHA-256 for dedup
  ownerId       String?  @map("owner_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Reverse relations
  examSections ExamSection[] @relation("ExamSectionAudio")
  examQuestionAudio ExamQuestion[] @relation("ExamQuestionAudio")
  examQuestionImage ExamQuestion[] @relation("ExamQuestionImage")

  @@index([storageKey])
  @@index([checksum])
  @@index([ownerId])
  @@index([status])
  @@map("media_files")
}
